# RowRunner Kitchen (KDS) — environment configuration
#
# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_ to the
# client. The anon key is safe to expose (it's a public, RLS-gated client key);
# never put the service_role key here.
#
# When the two VITE_SUPABASE_* vars are set, the KDS talks to the shared backend.
# Otherwise it falls back to a local in-memory mock (set VITE_USE_MOCK=1 to force).

# ── Supabase (the shared backend) ────────────────────────────
# Dashboard ▸ Project Settings ▸ API:
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "Project API keys ▸ anon public"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Fallback (ignored when Supabase is set) ──────────────────
# VITE_USE_MOCK=1

# Which venue this build serves
VITE_VENUE_ID=uri-mens-soccer
